# ═══════════════════════════════════════════════════════════════════
#  UAV Ground Station — Environment Variables
#  Copy this file to .env and adjust for your deployment.
# ═══════════════════════════════════════════════════════════════════

# ── Network ─────────────────────────────────────────────────────────
# Bind host for the web server.
# Use 0.0.0.0 to listen on all interfaces (LAN + Tailscale).
HOST=0.0.0.0

# HTTP / WebSocket port for the web interface.
WEB_PORT=8000

# UDP port on which video packets are received from the UAV.
# Must match the sender-side PORT setting.
UDP_PORT=5000

# Default fixed-wing stream ports exposed by docker-compose. The live UI
# stream-port field is still the source of truth at runtime.
UAV1_STREAM_PORT=5600
UAV2_STREAM_PORT=5601

# ── Video ─────────────────────────────────────────────────────────
# Maximum frames per second forwarded over WebSocket to browsers.
# Lower this if server CPU is high. The UDP receiver always runs at
# full stream rate regardless of this setting.
VIDEO_FPS_LIMIT=30

# JPEG re-encode quality (1–100). Higher = better quality, more bandwidth.
VIDEO_JPEG_QUALITY=80

# Maximum simultaneous video WebSocket clients.
VIDEO_MAX_CLIENTS=10

# ── Tailscale ────────────────────────────────────────────────────
# Set to true when the server is reachable via Tailscale.
# Enables Tailscale-specific logging; does not change network behaviour.
TAILSCALE_ENABLED=false

# ── Logging ─────────────────────────────────────────────────────
# Python logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# ── Telemetry ──────────────────────────────────────────────────
# Simulated telemetry publish rate in Hz (real MAVLink ignores this).
TELEMETRY_HZ=5.0

# ── Snapshots ──────────────────────────────────────────────────
# Directory where browser-triggered snapshots are saved server-side.
SNAPSHOT_DIR=snapshots

# Integrated live stitching sessions directory.
STITCH_SESSIONS_DIR=stitching_service/sessions

# Images required since the last run before auto-stitch starts.
STITCH_AUTO_THRESHOLD=5

# Browser-facing URL used when building the Next.js client.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Route-planned swarm (UAV slots 3 and 4). Configure before Upload/Start.
# Independent secrets: operator token is entered in the dashboard, link key on both Pis.
SWARM_OPERATOR_TOKEN= 
SWARM_LINK_KEY=
SWARM_LEGACY_ENABLED=true
SWARM_STORE_PATH=data/swarm.sqlite3
# Set actual site coordinates; leaving these unset blocks new swarm operations.
# SWARM_CENTER_LAT=
# SWARM_CENTER_LON=
SWARM_RADIUS_M=200
SWARM_MIN_ALT_M=2
SWARM_MAX_ALT_M=50
SWARM_TAKEOFF_ALT_M=5
SWARM_MIN_BATTERY_PCT=25
SWARM_FRESHNESS_S=2
SWARM_ACK_TIMEOUT_S=3
# Min-max route planner: match WPNAV_SPEED, ATC_SLEW_YAW and the companion hold time.
SWARM_PLANNER_V_CRUISE_MPS=5
SWARM_PLANNER_T_ACCEL_S=2
SWARM_PLANNER_YAW_RATE_DPS=60
SWARM_PLANNER_DWELL_S=3
SWARM_PLANNER_WIND_SPEED_MPS=0
SWARM_PLANNER_WIND_FROM_DEG=0
SWARM_PLANNER_TIME_LIMIT_S=10
SWARM_DEFER_S=25
SWARM_END_ACTION=RTL
# Match the companion safety JSON's min_separation_m and apf section.
APF_D_SAFE=10
APF_D_INFLUENCE=30
APF_K_ATT=1
APF_K_REP=100
APF_MAX_OFFSET=20
APF_TICK_RATE_HZ=5
# Avoidance engages when the predicted closest approach (within the horizon) is below
# APF_ENTER_M; must stay above APF_D_SAFE. Match the companion JSON "apf" section.
APF_ENTER_M=15
APF_EXIT_M=20
APF_PREDICTION_HORIZON_S=4
